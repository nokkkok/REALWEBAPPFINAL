<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitMatch</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="fm-navbar">
            <div class="fm-navbar-inner">
                <!-- Logo ซ้าย -->
                <a class="fm-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" asp-append-version="true" alt="FitMatch Logo" class="fm-brand-logo" />
                    <span><span class="fm-brand-fit">FIT</span><span class="fm-brand-match">MATCH</span></span>
                </a>

                <!-- User info ขวา -->
                <div class="fm-user-info">
                    <div class="fm-user-text">
                        <div class="fm-username">@(ViewData["UserName"] ?? "EARTHY")</div>
                        <div class="fm-useremail">@(ViewData["UserEmail"] ?? "earthy@kmitl.ac.th")</div>
                    </div>
                    <div class="fm-avatar">
                        <img src="@(ViewData["UserAvatar"] ?? "/images/imageAvatar.png")" alt="profile" />
                    </div>
                </div>

                <div class="auth-links">
                    <a href="#">Register</a>
                    <a href="#">Login</a>
            </div>
        </nav>
    </header>

    <div class="fm-page-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - project - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

